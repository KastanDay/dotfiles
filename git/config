# ~/.config/git/config
[diff]
context = 3
renames = copies
interHunkContext = 10

[pager]
diff = diff-so-fancy | $PAGER

[diff-so-fancy]
markEmptyLines = false

[interactive]
diffFilter = diff-so-fancy --patch
singlekey = true

[push]
autoSetupRemote = true
default = current
followTags = true

[pull]
default = current
rebase = true

[rebase]
missingCommitsCheck = warn

[branch]
sort = -committerdate

[tag]
sort = -taggerdate
[user]
	email = kastanvday@gmail.com
	name = Kastan Day
[includeIf "hasconfig:remote.*.url:git@gitlab.cfdata.org:*/**"]
	path = /Users/kastan/.config/git/cloudflare
[includeIf "hasconfig:remote.*.url:https://gitlab.cfdata.org/**"]
	path = /Users/kastan/.config/git/cloudflare
[include]
	path = /Users/kastan/.local/share/cloudflare-warp-certs/gitconfig
[trace2]
	eventTarget = af_unix:stream:/Users/kastan/.git-ai/internal/daemon/trace2.sock
	eventNesting = 10
[core]
	excludesFile = /Users/kastan/.config/git/ignore
